{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-workbench/schemas/prompt.schema.json",
  "title": "Prompt revision content (format_version 1)",
  "type": "object",
  "required": ["format_version", "kind", "template_engine", "input_schema", "output"],
  "properties": {
    "format_version": { "const": 1 },
    "kind": { "enum": ["chat", "text"] },
    "template_engine": { "const": "simple-v1" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "text": { "type": ["string", "null"] },
    "input_schema": { "type": "object" },
    "output": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["text", "json", "native_json_schema"] },
        "schema": { "type": ["object", "null"] }
      }
    },
    "tools": { "type": "array", "items": { "type": "object" } },
    "tool_choice": {},
    "default_model": { "type": ["object", "null"] }
  }
}
