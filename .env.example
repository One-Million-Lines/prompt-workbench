# Example environment file. Copy to .env and fill in values as needed.
# NEVER commit real secrets.

# --- Storage ---
PROMPT_WORKBENCH_STORAGE_BACKEND=sqlite
# PROMPT_WORKBENCH_MONGO_URI=mongodb://127.0.0.1:27017
# PROMPT_WORKBENCH_MONGO_DB=prompt_workbench

# --- Server ---
PROMPT_WORKBENCH_HOST=127.0.0.1
PROMPT_WORKBENCH_PORT=8765

# --- Auth (leave unset to auto-generate a local secret file) ---
# PROMPT_WORKBENCH_JWT_SECRET=

# --- Providers ---
# auto | mock | litellm
PROMPT_WORKBENCH_PROVIDER_MODE=mock

# Provider credentials are referenced by env-var NAME from a connection.
# Set the actual keys here (used only when provider_mode enables real calls):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
